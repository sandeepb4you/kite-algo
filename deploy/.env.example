# Copy to deploy/.env and fill in. Not read by the application — these two are
# consumed by Caddy through docker-compose.

# The hostname you will reach the UI on. Must be a domain whose DNS A record
# points at this box: Caddy obtains a certificate for it over HTTP-01, which
# requires port 80 to be reachable from the internet at the moment of issue.
#
# This value also has to match web.public_url in config.yaml, and
# <public_url>/kite/callback must be registered CHARACTER FOR CHARACTER as the
# redirect URL of your Kite Connect app. Zerodha allows no wildcards.
SITE_ADDRESS=kite.example.com

# Space-separated allowlist. CIDR notation is accepted.
#
# Everything not listed gets a 404 — not a login page, not a 403 that would
# confirm something is here.
#
# CAVEAT, since this is the weak point of an allowlist: a residential ISP
# usually rotates your address. When it does, you are locked out of your own
# trading UI, and you will discover it at the worst moment. Keep a second way
# onto the box (SSH) so you can edit this file and `docker compose up -d caddy`.
ALLOWED_IPS=203.0.113.42 198.51.100.0/24
