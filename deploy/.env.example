# Copy to deploy/.env and fill in. Consumed by Caddy through docker-compose;
# the application itself reads none of these.

# The server's PUBLIC IP, with no scheme and no port.
#
# Must also match web.public_url in config.yaml (as https://<this>), and
# https://<this>/kite/callback must be registered CHARACTER FOR CHARACTER as
# the redirect URL of your Kite Connect app.
#
# Note this is the one real drawback of running without a domain: if you ever
# rebuild the server and it comes up on a different IP, the certificate, the
# config and the Kite redirect registration all have to be updated together.
SITE_ADDRESS=203.0.113.10

# Space-separated allowlist of the addresses YOU browse from. CIDR accepted.
# Everything else gets a 404 — not a login page, not a 403 that would confirm
# something is running here.
#
# CAVEAT: a residential ISP rotates your address. When it does you are locked
# out of your own trading UI, and you will find out at the worst moment. Keep
# SSH working so you can edit this and `docker compose up -d caddy`.
ALLOWED_IPS=27.7.11.10

# To reach the UI from anywhere — phone on mobile data, laptop on other
# networks — open it up:
#
#   ALLOWED_IPS=0.0.0.0/0 ::/0
#
# Know what that spends. The RHEL bootstrap configures no host firewall, so on
# that path this allowlist is the last network-layer control in front of the
# trading UI; opening it leaves the operator password as the only thing between
# the internet and a UI that can arm live orders, on a box holding your Kite
# api_secret. The login lockout still throttles per source IP (that is what
# web.trust_proxy: true buys), so this is one factor rather than none — but it
# is one factor.
#
# The better fit for roaming devices is a VPN, because an IP allowlist is the
# wrong shape for them: a phone's address changes with every cell tower.
# Tailscale gives each device a stable private address on any network —
# `tailscale up` on the server and on each device, then:
#
#   ALLOWED_IPS=100.64.0.0/10
#
# Every device keeps working, the UI stays invisible to the public internet,
# and the ISP-rotation lockout above stops being a way to lose access.
#
# Changing this needs no rebuild:  docker compose up -d caddy
