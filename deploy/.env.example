# Copy to deploy/.env and fill in. Consumed by Caddy through docker-compose;
# the application itself reads none of these.

# The server's PUBLIC IP, with no scheme and no port.
#
# Must also match web.public_url in config.yaml (as https://<this>), and
# https://<this>/kite/callback must be registered CHARACTER FOR CHARACTER as
# the redirect URL of your Kite Connect app.
#
# Note this is the one real drawback of running without a domain: if you ever
# rebuild the server and it comes up on a different IP, the certificate, the
# config and the Kite redirect registration all have to be updated together.
SITE_ADDRESS=203.0.113.10

# Space-separated allowlist of the addresses YOU browse from. CIDR accepted.
# Everything else gets a 404 — not a login page, not a 403 that would confirm
# something is running here.
#
# CAVEAT: a residential ISP rotates your address. When it does you are locked
# out of your own trading UI, and you will find out at the worst moment. Keep
# SSH working so you can edit this and `docker compose up -d caddy`.
ALLOWED_IPS=27.7.11.10
